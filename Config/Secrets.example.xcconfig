// Copy to Config/Secrets.xcconfig locally when external services are configured.
// Never commit real keys. RevenueCat public SDK keys are still separated by build configuration.
WK_PURCHASES_ENABLED = YES
// Keep V1 analytics off until consent UX and TST-019/TST-022 are complete.
WK_ANALYTICS_ENABLED = NO
WK_REVENUECAT_API_KEY =
WK_POSTHOG_PROJECT_TOKEN =
WK_POSTHOG_HOST = https:/$()/eu.i.posthog.com
