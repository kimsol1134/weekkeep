    "onboarding.headline": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are so many photos,\nbut no time to sort them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 많은데,\n정리할 시간은 없으니까."
          }
        }
      }
    },
    "onboarding.body": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll start with your most recently completed Monday–Sunday week and choose up to seven moments. If that week has no eligible photos, we’ll honestly check your most recent 7 days instead."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 완료된 월요일부터 일요일까지의 한 주로 시작해 최대 7장의 순간을 골라드려요. 그 주에 적격 사진이 없으면 최근 7일을 대신 확인해요."
          }
        }
      }
    },
    "onboarding.privacy": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are processed on your iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 고르기는 이 iPhone 안에서 이뤄져요"
          }
        }
      }
    },
    "onboarding.primary": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your first week"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 주 추억 고르기"
          }
        }
      }
    },
    "onboarding.secondary": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does photo access work?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근을 어떻게 쓰나요?"
          }
        }
      }
    },
    "onboarding.privacyTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are processed on your iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 고르기는 이 iPhone 안에서 이뤄져요"
          }
        }
      }
    },
    "onboarding.privacyDetail": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo selection and share rendering are processed on your iPhone. Weekkeep does not send photos or photo details to analytics services or other services for analysis. Sharing starts only when you explicitly choose it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 고르기와 공유 이미지 만들기는 이 iPhone에서 처리해요. 사진·미리보기·파일 이름·위치·촬영 시각 같은 사진 정보는 사용 통계나 다른 서비스의 분석을 위해 보내지 않아요. 공유는 직접 선택할 때만 시작돼요."
          }
        }
      }
    },
    "accessibility.onboardingPreview": {
      "comment": "Accessibility label for the static onboarding keepsake preview",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preview of an album with seven moments"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일곱 순간을 담은 앨범 미리보기"
          }
        }
      }
    },
    "accessibility.photoStory": {
      "comment": "Accessibility label for the static seven-photo explanatory story",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven sample photos in one Weekkeep album"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep 앨범에 담은 샘플 사진 일곱 장"
          }
        }
      }
    },
    "week.readyTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to keep a few moments from last week?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난주의 순간을 남겨볼까요?"
          }
        }
      }
    },
    "week.readyBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll choose up to seven moments from last week that you may want to revisit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난주 사진에서 다시 보고 싶은 순간을 최대 7장 골라드려요."
          }
        }
      }
    },
    "week.welcomeBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll start with your most recently completed Monday–Sunday week and choose up to seven moments. Change only the photos you don’t want."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 완료된 월요일부터 일요일까지의 한 주로 시작해 최대 7장의 순간을 골라드려요. 마음에 들지 않는 사진만 바꿔보세요."
          }
        }
      }
    },
    "week.welcomeFallbackBody": {
      "comment": "Truthful fallback copy when the completed calendar week has no eligible photos",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That week had no eligible photos, so we’re checking your most recent 7 days for up to seven moments."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 주에 적격 사진이 없어 최근 7일에서 최대 7장의 순간을 확인해요."
          }
        }
      }
    },
