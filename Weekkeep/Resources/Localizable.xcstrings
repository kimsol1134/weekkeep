    "week.noPhotosBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only photos inside the requested date range are used. Check your Photos access or try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 날짜 안의 사진만 사용해요. 사진 접근을 확인하거나 다시 시도해 보세요."
          }
        }
      }
    },
    "week.waitingTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the next week to finish."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 기록을 기다리고 있어요."
          }
        }
      }
    },
    "week.waitingBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next regular memory will be ready after a full Monday–Sunday week."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월요일부터 일요일까지 한 주가 지나면 다음 기록을 만들 수 있어요."
          }
        }
      }
    },
    "week.savedTitle": {
      "comment": "Weekkeep localized copy",
