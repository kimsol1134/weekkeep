          "stringUnit": {
            "state": "translated",
            "value": "Photo details aren’t sent for analysis"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 정보는 분석에 보내지 않아요"
          }
        }
      }
    },
    "privacy.notTrackedBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep does not send photos, previews, filenames, locations, capture times, or other photo details to analytics services or other services for analysis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진·미리보기·파일 이름·위치·촬영 시각 같은 정보는 사용 통계나 다른 서비스의 분석을 위해 보내지 않아요."
          }
        }
      }
    },
    "privacy.youDecideTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re in control"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정은 내가 해요"
          }
        }
      }
    },
    "privacy.youDecideBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing starts only when you explicitly choose it. You can change photo access any time in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유는 직접 선택할 때만 시작돼요. 사진 접근은 언제든 설정에서 바꿀 수 있어요."
          }
        }
      }
    },
    "privacy.storageTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly records stay on this iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 iPhone에만 저장돼요"
          }
        }
      }
    },
    "privacy.storageBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep doesn't provide a separate backup, so records may be lost if you delete the app or change devices. Your original photos stay in Photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep은 별도 백업을 제공하지 않아 앱을 삭제하거나 기기를 바꾸면 기록이 사라질 수 있어요. 원본 사진은 사진 앱에 남아 있어요."
          }
        }
      }
    },
