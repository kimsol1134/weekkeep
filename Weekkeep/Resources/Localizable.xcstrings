    "onboarding.headline": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are so many photos,\nbut no time to sort them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 많은데,\n정리할 시간은 없으니까."
          }
        }
      }
    },
    "onboarding.body": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We choose up to seven from your last week.\nChange only the ones you don't want, then save."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 7일에서 최대 7장을 골라드려요.\n마음에 안 드는 사진만 바꾸고 저장하면 끝이에요."
          }
        }
      }
    },
    "onboarding.privacy": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos stay on this iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 iPhone에서만 살펴봐요"
          }
        }
      }
    },
    "onboarding.primary": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the last 7 days"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 7일 남기기"
          }
        }
      }
    },
    "onboarding.secondary": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How does photo access work?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근을 어떻게 쓰나요?"
          }
        }
      }
    },
    "onboarding.privacyTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos stay on this iPhone"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진은 이 iPhone 안에만 있어요"
          }
        }
      }
    },
    "onboarding.privacyDetail": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep looks at photos on this iPhone to prepare a small weekly draft. Photo pixels and identifiers are not sent to analytics or vendors."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep은 이 iPhone 안의 사진을 살펴보고 작은 주간 초안을 준비해요. 사진 픽셀과 식별자는 분석이나 외부 서비스로 보내지 않아요."
          }
        }
      }
    },
    "accessibility.onboardingPreview": {
      "comment": "Accessibility label for the static onboarding keepsake preview",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keepsake preview with seven moments"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일곱 장면으로 만든 주간 기록 미리보기"
          }
        }
      }
    },
    "accessibility.photoStory": {
      "comment": "Accessibility label for the static seven-photo explanatory story",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seven approved sample photos in one Weekkeep story"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 샘플 사진 일곱 장으로 만든 Weekkeep 주간 기록"
          }
        }
      }
    },
    "week.readyTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Want to save last week?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난주를 남겨볼까요?"
          }
        }
      }
    },
    "week.readyBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We will look at last week's photos on this iPhone and make a draft of up to seven."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난주 사진을 이 iPhone에서 살펴보고 최대 7장의 초안을 만들어요."
          }
        }
      }
    },
    "week.makeDraft": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make a 7-photo draft"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "7장 초안 만들기"
          }
        }
      }
    },
