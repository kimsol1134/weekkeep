    "week.noPhotosTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no eligible photos in this range."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 기간에 적격 사진이 없어요."
          }
        }
      }
    },
    "week.noPhotosBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We won’t add photos from outside the requested dates. Check Photos access or try again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 기간 밖의 사진을 섞지 않아요. 사진 접근을 확인하거나 다시 시도해 보세요."
          }
        }
      }
    },
    "week.waitingTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next week is coming."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 기록이 곧 열려요."
          }
        }
      }
    },
    "week.waitingBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved first week is here to revisit while you wait."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 동안 첫 기록을 다시 볼 수 있어요."
          }
        }
      }
    },
    "week.waitingNextDate": {
      "comment": "Exact next eligible date shown as a calm schedule cue, never a countdown",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next available date: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 기록 가능일: %@"
          }
        }
      }
    },
    "week.waitingViewAlbum": {
      "comment": "Waiting state action to open the saved album",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View your saved week"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 주 보기"
          }
        }
      }
    },
    "week.waitingShareAlbum": {
      "comment": "Waiting state action to share the saved album",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this album"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범 공유하기"
          }
        }
      }
    },
    "week.waitingNoAlbum": {
      "comment": "Truthful waiting placeholder when the latest saved album cannot be loaded",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t load the saved photos right now. Saved weeks are still available."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장한 사진을 불러오지 못했어요. 지난 기록에서 다시 볼 수 있어요."
          }
        }
      }
    },
    "week.waitingMissingPhotos": {
      "comment": "Truthful waiting placeholder when the saved album has no available photos",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your saved week is here, but its photos aren’t available right now."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 기록은 남아 있지만 지금 사진을 불러올 수 없어요."
          }
        }
      }
    },
    "week.savedTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last week is saved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난주를 남겼어요."
          }
        }
      }
    },
    "week.savedBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can revisit this week in your saved weeks."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 기록에서 이 주를 다시 볼 수 있어요."
          }
        }
      }
    },
    "week.viewRecord": {
      "comment": "Weekkeep localized copy",
