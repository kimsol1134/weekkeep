    "week.permissionBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Photos access so Weekkeep can prepare a weekly draft on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 주간 초안을 만들려면 사진 접근을 허용해 주세요."
          }
        }
      }
    },
    "week.restrictedTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access is restricted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근이 제한되어 있어요."
          }
        }
      }
    },
    "week.restrictedBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device, parental, or organization policy controls Photos access. Weekkeep cannot change this policy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근은 기기, 보호자 또는 조직 정책으로 관리되고 있어요. Weekkeep에서 이 정책을 바꿀 수 없어요."
          }
        }
      }
    },
    "week.limited": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected photos only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
