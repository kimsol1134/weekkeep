      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See saved weeks"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 기록 보기"
          }
        }
      }
    },
    "week.permissionTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Weekkeep look through your photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 살펴볼 수 있게 해주세요."
          }
        }
      }
    },
    "week.permissionBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow photo access so Weekkeep can help you keep a small album on this iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 작은 앨범을 남길 수 있도록 사진 접근을 허용해 주세요."
          }
        }
      }
    },
    "week.restrictedTitle": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access is restricted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근이 제한되어 있어요."
          }
        }
      }
    },
    "week.restrictedBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device, parental, or organization policy controls Photos access. Weekkeep cannot change this policy."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 접근은 기기, 보호자 또는 조직 정책으로 관리되고 있어요. Weekkeep에서 이 정책을 바꿀 수 없어요."
          }
        }
      }
    },
    "week.limited": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the photos you selected"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 사진만 볼 수 있어요"
          }
        }
      }
    },
    "week.managePhotos": {
      "comment": "Weekkeep localized copy",
