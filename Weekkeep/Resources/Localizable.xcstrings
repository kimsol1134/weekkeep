    "week.lockedBody": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep future weeks with Weekkeep Plus. Your saved records stay readable on this iPhone without Plus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep Plus로 앞으로의 주도 남겨보세요. 기존 기록은 Plus 없이도 이 iPhone에서 계속 볼 수 있어요."
          }
        }
      }
    },
    "week.plus": {
      "comment": "Weekkeep localized copy",
