    "privacy.body": {
      "comment": "Weekkeep localized copy",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep looks at photos on this iPhone and does not send photo pixels or identifiers to analytics or vendors."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekkeep은 이 iPhone 안에서 사진을 살펴보고 사진 픽셀이나 식별자를 분석·외부 서비스로 보내지 않아요."
          }
        }
      }
    },
    "privacy.onDeviceTitle": {
      "comment": "Weekkeep localized copy",
