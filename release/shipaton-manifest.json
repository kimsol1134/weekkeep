  "category_decisions": [
    {
      "category": "Grand Prize",
      "decision": "Conditional",
      "role": "stretch",
      "reason": "Submit only after verified public launch and release/growth metrics."
    },
    {
      "category": "#BuildInPublic",
      "decision": "Focus",
      "role": "supporting",
      "reason": "Requires public links and a short evidence-backed description of how public building improved the app."
    },
    {
      "category": "Best Game",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep is not a game and will not add game scope."
    },
    {
      "category": "RevenueCat Peace Prize",
      "decision": "Conditional",
      "role": null,
      "reason": "Submit only with direct parent evidence about reduced memory-keeping burden or privacy understanding."
    },
    {
      "category": "RevenueCat Design Award",
      "decision": "Focus",
      "role": "primary",
      "reason": "The exact-seven visual system, review interaction, restraint, and local-first trust are the strongest fit."
    },
    {
      "category": "Catvertising",
      "decision": "Exclude",
      "role": null,
      "reason": "This category is about creative/effective use of RevenueCat Ads, not cat-themed advertising. Weekkeep does not use RevenueCat Ads and will not add interruptive ads merely to chase the category because that conflicts with the calm product experience."
    },
    {
      "category": "Next Gen",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep is being submitted on the non-Next-Gen app track."
    },
    {
      "category": "HAMM Award (Help Apps Make Money)",
      "decision": "Focus",
      "role": "secondary",
      "reason": "Submit with verified pricing, paywall, conversion, and revenue evidence."
    },
    {
      "category": "Conflict of Interest",
      "decision": "Exclude",
      "role": null,
      "reason": "No qualifying conflict-of-interest case is part of the Weekkeep submission."
    },
    {
      "category": "Productivity / Christopher Lawley",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep is a parent memory product, not a general productivity tool."
    },
    {
      "category": "Nutrition & Healthy Eating / Abbey’s Kitchen",
      "decision": "Exclude",
      "role": null,
      "reason": "The product is not about nutrition or healthy eating."
    },
    {
      "category": "Yoga & Fitness / Simone Sharice",
      "decision": "Exclude",
      "role": null,
      "reason": "The product is not about yoga or fitness."
    },
    {
      "category": "Career Coaching / Leadership Heather",
      "decision": "Exclude",
      "role": null,
      "reason": "The product is not career coaching."
    },
    {
      "category": "Gaming / Mr Lewis Blogs Gaming",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep is not a game and will not add gaming scope."
    },
    {
      "category": "Ship Kotlin Everywhere / JetBrains",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep is a Swift/iOS app; Kotlin or JetBrains scope will not be added."
    },
    {
      "category": "Most Viral App / Noise",
      "decision": "Conditional",
      "role": null,
      "reason": "Submit only if a live Noise campaign/account was actually used and measured."
    },
    {
      "category": "Best App for Galaxy / Samsung",
      "decision": "Exclude",
      "role": null,
      "reason": "Weekkeep targets iPhone, not Galaxy devices or the Samsung store."
    },
    {
      "category": "Idea to Income / Replit",
      "decision": "Exclude",
      "role": null,
      "reason": "There is no verified Replit build evidence and no Replit scope will be added."
    },
    {
      "category": "Keep Them Coming Back / OneSignal",
      "decision": "Exclude",
      "role": null,
      "reason": "V1 uses local notifications and explicitly excludes OneSignal and remote push."
    },
    {
      "category": "Growth Loop / Layers",
      "decision": "Exclude",
      "role": null,
      "reason": "There is no Layers integration or separate growth-loop scope, and no SDK will be added."
    },
    {
      "category": "Funnel Vision / Stripe",
      "decision": "Exclude",
      "role": null,
      "reason": "The category requires a live web-to-app funnel using RevenueCat Funnels with Stripe; Weekkeep has no such live funnel. V1 uses a native App Store non-consumable purchase through RevenueCat, and we will not add a web funnel only to chase the category."
    }
